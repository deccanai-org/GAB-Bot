# Copy to .env and set your Discord bot token (do not commit .env)
DISCORD_TOKEN=your_bot_token_here

# Alibaba Cloud Model Studio key with access to Qwen3-Omni-Flash (Singapore).
# Keep the actual value in ignored .env or deployment secrets, never in Git.
DASHSCOPE_API_KEY=

# Only for the Slack bot (python -m gab_faq slack)
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Deployment overrides (leave staging for local tests)
GAB_ENVIRONMENT=staging
HEALTH_HOST=127.0.0.1
HEALTH_PORT=8080
# Optional file logging; production stdout is structured JSON
# BOT_LOG_FILE=output/bot.log

# Knowledge / FAQ database (PostgreSQL). Never commit real passwords.
# Writer (schema init, import, Discord updates channel): GAB_KNOWLEDGE_ADMIN_DB
# Reader (bot answers from status=current only): GAB_KNOWLEDGE_DB
# GAB_KNOWLEDGE_ADMIN_DB=postgresql://gab_admin:***@host:5432/gab-bot
# GAB_KNOWLEDGE_DB=postgresql://gab_bot:***@host:5432/gab-bot
# Optional local folder StoreSource syncs published docs into:
# GAB_KNOWLEDGE_LIVE_DIR=output/knowledge-live
